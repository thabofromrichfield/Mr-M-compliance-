rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user: only the configured owner UID may access.
    function isOwner() {
      return request.auth != null && request.auth.token.email == "OWNER_EMAIL_PLACEHOLDER";
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
