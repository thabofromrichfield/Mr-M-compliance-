# Single owner only. No registration route exists.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Base64-encoded 32-byte AES-256 key for application-level document encryption.
DOCUMENT_ENCRYPTION_KEY=

# Configure Firebase Admin with either a JSON service account string or the three fields below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Comma-separated static allowlist. Outbound email never accepts recipients from requests.
ALERT_RECIPIENTS=finance@example.com,compliance@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClearLedger <alerts@example.com>
APP_BASE_URL=https://your-domain.example
CRON_SECRET=replace-with-a-random-cron-secret
